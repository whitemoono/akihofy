# AKIHO Environment Variables Template
# Copy this file to .env and fill in your values

# ============== LLM API Keys ==============
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
SILICONFLOW_API_KEY=

# ============== Database ==============
DATABASE_URL=postgresql://akiho:akiho_secret@localhost:5432/akiho
REDIS_URL=redis://localhost:6379/0

# ============== Application ==============
DEBUG=false
LOG_LEVEL=INFO

# ============== Security ==============
SECRET_KEY=change-this-to-a-random-secret-key

# ============== CORS ==============
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
